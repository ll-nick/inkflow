{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["@cloudflare/workers-types"],
        "strict": true,
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"]
}
